# ==========================================
# ADV3NT Visual Cortex Studio - Environment Configuration
# ==========================================

# Port and Network Binding
PORT=5173
HOST=0.0.0.0

# FAL.ai Integration (Primary Model Provider for Colleague Fork)
# Obtain your key from: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_api_key_here
VITE_FAL_KEY=your_fal_api_key_here

# Visual & Video Inference Providers (Optional Fallbacks)
GEMINI_API_KEY=your_gemini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Local Media Caching (Default: enabled)
ENABLE_LOCAL_MEDIA_STREAMING=true
